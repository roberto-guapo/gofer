package views

import (
	"fmt"
	"github.com/cristianadrielbraun/gofer/internal/auth"
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/systemmonitor"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	switchcomp "github.com/cristianadrielbraun/gofer/components/switch"
)

templ SystemMonitorScripts() {
	if auth.OwnerInstance(ctx) && auth.GetCurrentUser(ctx) != nil {
		<script src={ assetver.URL("/assets/js/system-monitor.js") }></script>
	}
}

// An inert, hidden shell keeps navigation and settings changes local. No
// statistics are read while rendering a page, including when enabled.
templ SystemMonitor() {
	if auth.OwnerInstance(ctx) && auth.GetCurrentUser(ctx) != nil && systemmonitor.Supported() {
		<section class="system-monitor" data-system-monitor hidden aria-label={ i18n.T(ctx, "monitor.title") }>
			<details>
				<summary class="system-monitor-heading">
					@icon.Activity(icon.Props{Class: "size-3.5 shrink-0"})
					<span>{ i18n.T(ctx, "monitor.title") }</span>
					@icon.ChevronDown(icon.Props{Class: "system-monitor-chevron size-3 shrink-0"})
				</summary>
				<div class="system-monitor-extra">
					@systemMonitorRow("disk", i18n.T(ctx, "monitor.disk"))
					@systemMonitorRow("uptime", i18n.T(ctx, "monitor.uptime"))
					@systemMonitorRow("process", i18n.T(ctx, "monitor.process"))
					<p class="system-monitor-note">{ i18n.T(ctx, "monitor.scope") }</p>
				</div>
			</details>
			<div class="system-monitor-readings">
				@systemMonitorRow("cpu", i18n.T(ctx, "monitor.cpu"))
				@systemMonitorRow("memory", i18n.T(ctx, "monitor.memory"))
				@systemMonitorRow("temperature", i18n.T(ctx, "monitor.temperature"))
			</div>
			<p class="system-monitor-note" data-monitor-status role="status">{ i18n.T(ctx, "js.monitor.loading") }</p>
		</section>
	}
}

templ systemMonitorRow(metric string, label string) {
	<div class="system-monitor-row">
		<span>{ label }</span>
		<span class="system-monitor-value" data-monitor-value={ metric }>—</span>
	</div>
}

templ SystemMonitorSettings(uiSettings map[string]string) {
	if auth.OwnerInstance(ctx) && auth.GetCurrentUser(ctx) != nil {
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div class="flex items-start justify-between gap-6">
				<div class="min-w-0">
					<label for="system-monitor-enabled" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "monitor.setting") }</label>
					<p id="system-monitor-description" class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "monitor.description") }</p>
					if !systemmonitor.Supported() {
						<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "monitor.linux_only") }</p>
					}
				</div>
				@switchcomp.Switch(switchcomp.Props{
					ID: "system-monitor-enabled",
					Name: systemmonitor.SettingKey,
					Checked: uiSettingGet(uiSettings, systemmonitor.SettingKey, "false") == "true",
					Disabled: !systemmonitor.Supported(),
					Attributes: templ.Attributes{"aria-describedby": "system-monitor-description", "aria-label": i18n.T(ctx, "monitor.setting"), "data-ui-setting-switch": systemmonitor.SettingKey},
				})
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex items-center justify-between gap-6">
				<span id="system-monitor-interval-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "monitor.interval_label") }</span>
				<div class="w-44 shrink-0">
					{{ selected := fmt.Sprint(int(systemmonitor.Interval(uiSettings[systemmonitor.IntervalSettingKey]).Seconds())) }}
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: systemmonitor.IntervalSettingKey, Class: "bg-background", DisableClear: true, Required: true, Disabled: !systemmonitor.Supported(), Attributes: templ.Attributes{"aria-labelledby": "system-monitor-interval-label", "data-system-monitor-interval": ""}}) {
							@selectbox.Value() { { i18n.T(ctx, "monitor.interval."+selected) } }
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							for _, seconds := range []string{"5", "15", "30", "60"} {
								@selectbox.Item(selectbox.ItemProps{Value: seconds, Selected: selected == seconds}) { { i18n.T(ctx, "monitor.interval."+seconds) } }
							}
						}
					}
				</div>
			</div>
		</div>
	}
}
